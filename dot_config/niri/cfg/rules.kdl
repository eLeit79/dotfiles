window-rule {
    geometry-corner-radius 15
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match app-id="alacritty-floating"

    default-column-width { fixed 1600; }
    default-window-height { proportion 0.6667; }

    open-floating true
}

window-rule {
    match app-id="Alacritty"

    default-column-width { proportion 0.3333; }

    open-focused true
}

window-rule {
    match app-id="godot-launcher"

    default-column-width { fixed 1280; }
    default-window-height { proportion 0.6667; }

    open-floating true
    open-focused true
}

// Guild Wars 2 (steam)
window-rule {
    match app-id="steam_app_1284210"

    variable-refresh-rate true

    focus-ring {
        off
    }

    border {
        off
    }

    shadow {
        off
    }
}

// No Man's Sky (steam)
window-rule {
    match app-id="steam_app_275850"

    variable-refresh-rate true

    open-fullscreen true
}

// Remnant 2 (steam)
window-rule {
    match app-id="steam_app_1282100"

    variable-refresh-rate true

    open-fullscreen true
}

window-rule {
    match app-id="org.gnome.Nautilus"

    default-column-width { fixed 1280; }
    default-window-height { proportion 0.6667; }

    open-floating true
}

window-rule {
    match app-id="net.davidotek.pupgui2"

    default-column-width { fixed 600; }
    default-window-height { proportion 0.3333; }

    open-floating true
}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}
